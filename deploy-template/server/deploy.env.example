# /home/deploy/apps/<app>/shared/deploy.env, read by activate.sh.
SERVICE=<app>.service
HEALTH_URL=http://127.0.0.1:<port>/up
# How many releases to keep for rollback.
KEEP=5
# Optional: a binary in the release that runs pending migrations before the switch.
# Ignite apps use their `ignite` binary: MIGRATE_BIN=ignite  (then `ignite migrate` runs).
# MIGRATE_BIN=ignite
